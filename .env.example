# PromptShield Environment Configuration
# Provide your Google Gemini / Google AI Studio API key to enable live Gemma AI Judge classification.
# If omitted, PromptShield automatically operates in deterministic MockJudge simulation mode.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional model override (leave blank to auto-discover active Gemma model)
# e.g. gemma-4-31b-it, gemma-2-9b-it, gemini-2.5-flash
PROMPTSHIELD_MODEL=
